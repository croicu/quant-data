# Build artifacts
build/
dist/
*.egg-info/

# Python cache files
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

# venv
.venv/

# ruff
.ruff_cache/

# Claude Code
.claude/

# pytest temp
.pytest_tmp/

# Local settings override (personal overrides, not committed)
settings.local.json

# Secrets / credentials — never commit real DB or SSH credentials
.env
*.pem
*.key

# Local DB backups (real data snapshots, personal-machine artifacts)
backups/

# Artifacts that go to the secondary (non-GitHub) git remote only.
/local/

# .exp/ (tasks/ibkr_massive_mad_calibration.md) output -- specific to the current data pipeline
# state on this box, not a stable artifact worth version-controlling; regenerable by rerunning the
# relevant .exp/ script. Ignored by file type rather than as a whole /results/ directory, so that
# results/ibkr_massive_mad/findings.md -- the task's own named final deliverable, a synthesized
# recommendation rather than a per-run byproduct -- stays tracked without needing a negation
# pattern (git prunes an entire ignored directory's subtree before evaluating any negation nested
# inside it, so `!/results/.../findings.md` under a bare `/results/` rule silently does nothing --
# confirmed live with `git check-ignore`; ignoring by extension avoids the problem entirely).
/results/**/*.parquet
/results/**/*.png
/results/ibkr_massive_mad/manifest.json
