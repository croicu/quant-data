# Build artifacts
build/
dist/
*.egg-info/

# Python cache files
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

# venv
.venv/

# ruff
.ruff_cache/

# Claude Code
.claude/

# pytest temp
.pytest_tmp/

# Local settings override (personal overrides, not committed)
settings.local.json

# Secrets / credentials — never commit real DB or SSH credentials
.env
*.pem
*.key

# Local DB backups (real data snapshots, personal-machine artifacts)
backups/

# Artifacts that go to the secondary (non-GitHub) git remote only.
/local/

# .exp/ (tasks/ibkr_massive_mad_calibration.md) output -- specific to the current data pipeline
# state on this box, not a stable artifact worth version-controlling. The task file's own
# conclusions/findings get updated by hand instead; results/ is regenerable by rerunning the
# relevant .exp/ script.
/results/
