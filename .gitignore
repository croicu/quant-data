# Build artifacts
build/
dist/
*.egg-info/

# Python cache files
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

# venv
.venv/

# ruff
.ruff_cache/

# Claude Code
.claude/

# pytest temp
.pytest_tmp/

# Local settings override (personal overrides, not committed)
settings.local.json

# Secrets / credentials — never commit real DB or SSH credentials
.env
*.pem
*.key

# Local DB backups (real data snapshots, personal-machine artifacts)
backups/

# Artifacts that go to the secondary (non-GitHub) git remote only. A dedicated
# local branch, never pushed to GitHub, has its own .gitignore that omits this
# line so the same path is tracked there.
/local/
