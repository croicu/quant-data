{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run (ingest)",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run (catch-up)",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": ["--catch-up"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run PyTest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Push Local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/sync_local.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": []
}
