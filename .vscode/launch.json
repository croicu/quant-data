{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": [
        "--ticker", "${input:ingestTicker}",
        "--start-date", "${input:ingestStartDate}",
        "--end-date", "${input:ingestEndDate}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Ingest (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": [
        "--ticker", "${input:ingestTicker}",
        "--start-date", "${input:ingestStartDate}",
        "--end-date", "${input:ingestEndDate}",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run PyTest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Push Local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/sync_local.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "ingestTicker",
      "type": "promptString",
      "description": "Ticker for --ticker (this config always passes --ticker/--start-date/--end-date, so leaving this blank passes an empty ticker, not settings.tickers)",
      "default": "SPY"
    },
    {
      "id": "ingestStartDate",
      "type": "promptString",
      "description": "Date for --start-date, YYYY-MM-DD",
      "default": "2026-08-14"
    },
    {
      "id": "ingestEndDate",
      "type": "promptString",
      "description": "Date for --end-date, YYYY-MM-DD",
      "default": "2026-08-14"
    }
  ]
}
