{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": [
        "@configs/all-providers.args",
        "--ticker", "${input:ingestTicker}",
        "--start-date", "${input:ingestStartDate}",
        "--end-date", "${input:ingestEndDate}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Ingest (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest.cli",
      "args": [
        "@configs/all-providers.args",
        "--ticker", "${input:ingestTicker}",
        "--start-date", "${input:ingestStartDate}",
        "--end-date", "${input:ingestEndDate}",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Schedule",
      "type": "debugpy",
      "request": "launch",
      "module": "schedule.cli",
      "args": [
        "@configs/all-providers.args",
        "--ticker", "${input:scheduleTicker}",
        "--start-date", "${input:scheduleStartDate}",
        "--end-date", "${input:scheduleEndDate}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Schedule (dry run)",
      "type": "debugpy",
      "request": "launch",
      "module": "schedule.cli",
      "args": [
        "@configs/all-providers.args",
        "--ticker", "${input:scheduleTicker}",
        "--start-date", "${input:scheduleStartDate}",
        "--end-date", "${input:scheduleEndDate}",
        "--dry-run"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Schedule (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "schedule.cli",
      "args": [
        "@configs/all-providers.args",
        "--ticker", "${input:scheduleTicker}",
        "--start-date", "${input:scheduleStartDate}",
        "--end-date", "${input:scheduleEndDate}",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Dispatch",
      "type": "debugpy",
      "request": "launch",
      "module": "dispatch.cli",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Dispatch (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "dispatch.cli",
      "args": ["--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run PyTest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Push Local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/sync_local.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: E0 Join Integrity",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.exp/join_integrity/coverage.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "ingestTicker",
      "type": "promptString",
      "description": "Ticker for --ticker (this config always passes --ticker/--start-date/--end-date, so leaving this blank passes an empty ticker, not settings.tickers)",
      "default": "SPY"
    },
    {
      "id": "ingestStartDate",
      "type": "promptString",
      "description": "Date for --start-date, YYYY-MM-DD",
      "default": "2026-08-14"
    },
    {
      "id": "ingestEndDate",
      "type": "promptString",
      "description": "Date for --end-date, YYYY-MM-DD",
      "default": "2026-08-14"
    },
    {
      "id": "scheduleTicker",
      "type": "promptString",
      "description": "Ticker for --ticker (quant-schedule always requires --ticker, unlike quant-ingest -- there's no settings.tickers fallback)",
      "default": "SPY"
    },
    {
      "id": "scheduleStartDate",
      "type": "promptString",
      "description": "Date for --start-date, YYYY-MM-DD",
      "default": "2026-08-14"
    },
    {
      "id": "scheduleEndDate",
      "type": "promptString",
      "description": "Date for --end-date, YYYY-MM-DD",
      "default": "2026-08-14"
    }
  ]
}
